# Ignore environment variable files
.env

# Ignore the data/exported content
data/exported/**/*
!data/exported/.gitkeep
#Ignore the data/raw content
data/raw/**/*
!data/raw/.gitkeep
# Ignore the data/curated content
data/curated/**/*
!data/curated/.gitkeep
# Ignore the data/staged content
data/staged/**/*
!data/staged/.gitkeep

# Ignore virtual environment directories
.venv